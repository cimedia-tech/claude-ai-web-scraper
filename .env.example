# Claude AI Web Scraper — Environment Variables
# Copy this to .env and fill in your values

# ── Required ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Model (use Haiku for cost, Sonnet for quality) ─
CLAUDE_MODEL=claude-haiku-4-5
MAX_TOKENS=1024

# ── Crawling ───────────────────────────────────────
MAX_PAGES_PER_RUN=50
PAGE_TIMEOUT_MS=30000
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=4.5
MAX_TOKEN_INPUT=8000

# ── Cache ──────────────────────────────────────────
CACHE_TTL_HOURS=24
DB_PATH=data/scraper_cache.db

# ── Output ─────────────────────────────────────────
OUTPUT_DIR=output
